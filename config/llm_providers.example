# ============================================
# LLM Provider Configuration
# ============================================
# This file shows how to configure different LLM providers
# Set the provider using AISUITE_PROVIDER environment variable

# ============================================
# Option 1: Ollama (Local) - Default
# ============================================
# Best for: Privacy, offline usage, no API costs
# Requires: Docker container running ollama
# 
# Environment:
#   AISUITE_PROVIDER=ollama
#   OLLAMA_BASE_URL=http://ollama:11434
#   OLLAMA_MODEL=llama3.2
#   
# Run with profile: minimal, local, aura, or webui
# Docker: docker compose --profile minimal up -d

# ============================================
# Option 2: Blablador / Helmholtz (Cloud)
# ============================================
# Best for: High-performance inference, Helmholtz AI research
# Requires: API key from Helmholtz
#
# Environment:
#   AISUITE_PROVIDER=blablador
#   BLABLADOR_API_URL=https://helmholtz.ai/blablador/api/v1
#   BLABLADOR_API_KEY=your_api_key_here
#   BLABLADOR_MODEL=alias-fast
#
# Create secrets:
#   echo -n "your_api_key" > secrets/blablador_api_key.txt
#   echo -n "https://helmholtz.ai/blablador/api/v1" > secrets/blablador_api_url.txt
#   echo -n "alias-fast" > secrets/blablador_model.txt

# ============================================
# Option 3: OpenAI
# ============================================
# Best for: Wide model selection, reliability
# Requires: OpenAI API key
#
# Environment:
#   AISUITE_PROVIDER=openai
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-4o

# ============================================
# Option 4: Anthropic (Claude)
# ============================================
# Best for: Long context, reasoning capabilities
# Requires: Anthropic API key
#
# Environment:
#   AISUITE_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
#   ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============================================
# Option 5: Google Gemini
# ============================================
# Best for: Multimodal, fast inference
# Requires: Google AI API key
#
# Environment:
#   AISUITE_PROVIDER=google
#   GOOGLE_API_KEY=AI...
#   GOOGLE_MODEL=gemini-1.5-pro

# ============================================
# Docker Compose with External Ollama
# ============================================
# If you want to use an external Ollama (not in Docker):
#
# 1. Set AISUITE_PROVIDER=ollama
# 2. Set OLLAMA_BASE_URL=http://host.docker.internal:11434 (Linux)
#    or OLLAMA_BASE_URL=http://localhost:11434 (Mac/Windows)
#
# Or disable Ollama container entirely:
#   docker compose up -d --no-attach ollama

# ============================================
# Quick Start Commands
# ============================================
#
# With Aura + Ollama (local Docker):
#   docker compose --profile aura up -d
#
# With Aura + Blablador:
#   docker compose --profile aura up -d (set BLABLADOR_* vars)
#
# Minimal: API only (requires external LLM or Ollama on host):
#   docker compose --profile minimal up -d
#   # Then set OLLAMA_BASE_URL=http://host.docker.internal:11434
#
# WebUI (full stack):
#   docker compose --profile webui up -d
