# Italian Tutor - Environment Configuration Example
# Copy this file to .env and update with your values

# ============================================
# Neo4j Configuration
# ============================================
# For local Neo4j (docker compose --profile neo4j up):
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# Password is loaded from secrets/neo4j_password.txt

# For Neo4j Aura (cloud):
# NEO4J_URI=neo4j+s://8f94a040.databases.neo4j.io
# USE_AURA=true

NEO4J_DATABASE=neo4j
USE_AURA=false

# ============================================
# LiteLLM Configuration
# ============================================
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MODEL=gpt-4
LITELLM_PORT=4000

# ============================================
# OpenWebUI Configuration
# ============================================
WEBUI_PORT=3000
DEFAULT_MODELS=gpt-4

# ============================================
# API Configuration
# ============================================
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"

# ============================================
# Ports (for docker-compose)
# ============================================
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# ============================================
# LiteLLM Provider Configuration
# ============================================
# Add your LLM provider credentials here
# Examples:

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Local Ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Azure OpenAI
# AZURE_API_KEY=...
# AZURE_API_BASE=...
# AZURE_DEPLOYMENT_NAME=...

# ============================================
# Blablador (Support Provider)
# ============================================
# BLABLADOR_API_URL=
***REMOVED***=
# BLABLADOR_MODEL=alias-fast

# ============================================
# Security Settings (Auto-generated)
# ============================================
# These are loaded from Docker secrets
# Do NOT set them here in .env

# AUTH_SECRET_KEY - loaded from secrets/auth_secret_key.txt
***REMOVED*** - loaded from secrets/webui_secret_key.txt
# LITELLM_MASTER_KEY - loaded from secrets/litellm_api_key.txt
# LITELLM_SALT_KEY - loaded from secrets/litellm_salt_key.txt
