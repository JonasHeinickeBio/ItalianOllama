WEBUI_SECRET_KEY=your-webui-secret-key-here
OPENWEBUI_API_KEY=your-openwebui-api-key-here
BLABLADOR_API_KEY=your-blablador-api-key-here
BLABLADOR_API_URL=https://api.helmholtz-blablador.fz-juelich.de/v1/
BLABLADOR_MODEL=alias-fast
OLLAMA_MODEL=llama3.2
AISUITE_PROVIDER=ollama
AISUITE_API_KEY=

OPENROUTER_API_KEY=your-openrouter-api-key-here
# Neo4j Aura Configuration (Cloud)
# Use this file to connect to Neo4j Aura instead of local Docker container
#
# Usage: Copy to .env and adjust values
#   cp .env.aura .env
#
# Wait 60 seconds after instance creation before connecting!

# Neo4j Aura Connection Details
# Get these from https://console.neo4j.io


# Aura Instance Details
AURA_INSTANCEID=8f94a040
AURA_INSTANCENAME=ItalianOllama

# Use Aura instead of local Neo4j
USE_AURA=false

# Language Service Settings
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# ============================================
# Local Service Ports (development)
# ============================================
API_PORT_LOCAL=8080
CHAINLIT_PORT_LOCAL=8511
STREAMLIT_PORT_LOCAL=8512

# ============================================
# Container Service Ports (docker-compose)
# ============================================
API_PORT=8000
CHAINLIT_PORT=8501
STREAMLIT_PORT=8502
LITELLM_PORT=4000

# Container URLs (for container-to-container communication)
BACKEND_URL=http://localhost:8000
CHAINLIT_URL=http://localhost:8501

# Local URLs (for local development)
BACKEND_URL_LOCAL=http://localhost:8080
CHAINLIT_URL_LOCAL=http://localhost:8511
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here
NEO4J_DATABASE=neo4j
NEO4J_BOLT_PORT=7688
NEO4J_HTTP_PORT=7475
